
# AI Preview Image Generator credentials
# Renderer (the default provider is openai):
# OPENAI_API_KEY=...      # https://platform.openai.com/api-keys (also powers --enhance)
# XAI_OAUTH_TOKEN=...     # preferred. Mint (no Kilo):
#                         #   curl -fsSL https://x.ai/cli/install.sh | bash
#                         #   grok login
#                         # then copy ~/.grok/auth.json's auth.x.ai "key".
#                         # A laptop that just ran `grok login` does not need this line.
#                         # Full steps: docs/PREVIEW-IMAGES.md#terminal-only-oauth-no-kilo
# XAI_API_KEY=...         # https://console.x.ai/ (last resort; OAuth wins when both are set)
# STABILITY_API_KEY=...   # https://platform.stability.ai/
# GEMINI_API_KEY=...      # https://aistudio.google.com/apikey

# Claude orchestration (analyzes articles + reviews renders) — any ONE of
# (or a logged-in `claude` CLI; optional, degrades to template prompts):
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...   # from `claude setup-token`
# ANTHROPIC_API_KEY=sk-ant-...               # from console.anthropic.com

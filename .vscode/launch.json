// lifehacker.dev · .vscode/launch.json — fleet-vscode/v1 · 2026-09-09. Convention + vocabulary: .vscode/README.md.
// The preview serves the OVERLAY build (theme clone + this repo's content), so webRoot points at /tmp/lh-preview/_site and DevTools shows the files the browser actually got. Edits made in DevTools land in a throwaway copy; a theme-side fix belongs upstream in bamr87/zer0-mistakes. If you set PREVIEW_DIR for preview.sh, point webRoot at the same place.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: site in Edge (:4000)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:4000",
      "webRoot": "/tmp/lh-preview/_site",
      "preLaunchTask": "Serve"
    },
    {
      "name": "Debug: live site (lifehacker.dev)",
      "type": "msedge",
      "request": "launch",
      "url": "https://lifehacker.dev"
    }
  ]
}
